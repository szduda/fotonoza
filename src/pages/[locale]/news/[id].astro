---
import { getCollection, render } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getMessages } from "@/lib/i18n";
import type { Lang } from "@/lib/i18n";
import { homePath, isSupportedLocale, newsArticlePath, newsIndexPath, otherLocale } from "@/lib/locale";

export async function getStaticPaths() {
  const posts = await getCollection("progress");
  const locales: Lang[] = ["en", "pl"];
  return locales.flatMap((locale) =>
    posts.map((post) => ({
      params: { locale, id: post.id },
      props: { post }
    }))
  );
}

const raw = Astro.params.locale;
if (!isSupportedLocale(raw)) {
  return Astro.redirect("/en/");
}

const lang: Lang = raw;
const { post } = Astro.props;

const t = getMessages(lang);
const { Content } = await render(post);
const path = newsArticlePath(lang, post.id);
const title = `${post.data.title} ${t.newsPage.postTitleSuffix}`.trim();
---

<BaseLayout
  lang={lang}
  path={path}
  title={title}
  description={post.data.description}
  alternatePaths={{
    en: newsArticlePath("en", post.id),
    pl: newsArticlePath("pl", post.id)
  }}
>
  <article class="container py-16">
    <header class="mx-auto max-w-3xl">
      <p class="text-sm text-zinc-500">
        <a href={newsIndexPath(lang)} class="text-zinc-400 hover:text-white">{t.newsPage.backToNews}</a>
        <span class="mx-2 text-zinc-600">·</span>
        <a href={homePath(lang)} class="text-zinc-400 hover:text-white">fotonoza</a>
        <span class="mx-2 text-zinc-600">·</span>
        <a href={newsArticlePath(otherLocale(lang), post.id)} hreflang={otherLocale(lang)} class="text-zinc-400 hover:text-white">
          {lang === "en" ? "Polski" : "English"}
        </a>
      </p>
      <time class="mt-4 block text-sm text-zinc-500" datetime={post.data.pubDate.toISOString()}>
        {post.data.pubDate.toLocaleString(lang === "pl" ? "pl-PL" : "en-GB", { timeZone: "UTC" })} UTC
      </time>
      <h1 class="mt-2 text-3xl font-semibold tracking-tight text-white sm:text-4xl">{post.data.title}</h1>
      <p class="mt-3 text-lg text-zinc-400">{post.data.description}</p>
      {
        post.data.image ? (
          <figure class="mt-10 overflow-hidden rounded-xl border border-zinc-800">
            <img src={post.data.image} alt="" class="h-auto w-full object-cover" width={1280} height={720} />
          </figure>
        ) : null
      }
    </header>
    <div
      class="mx-auto mt-12 max-w-3xl space-y-4 leading-relaxed text-zinc-300 [&_a]:text-sky-400 [&_a]:underline-offset-2 hover:[&_a]:underline [&_code]:rounded [&_code]:bg-zinc-900 [&_code]:px-1 [&_code]:text-zinc-200 [&_h2]:mt-10 [&_h2]:text-xl [&_h2]:font-semibold [&_h2]:text-white [&_li]:my-1 [&_ul]:list-disc [&_ul]:pl-6"
    >
      <Content />
    </div>
  </article>
</BaseLayout>
