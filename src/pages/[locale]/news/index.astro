---
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getMessages } from "@/lib/i18n";
import type { Lang } from "@/lib/i18n";
import { homePath, isSupportedLocale, newsArticlePath, newsIndexPath, otherLocale } from "@/lib/locale";

export function getStaticPaths() {
  return [{ params: { locale: "en" } }, { params: { locale: "pl" } }];
}

const raw = Astro.params.locale;
if (!isSupportedLocale(raw)) {
  return Astro.redirect("/en/");
}

const lang: Lang = raw;
const t = getMessages(lang);
const posts = (await getCollection("progress")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
const path = newsIndexPath(lang);
---

<BaseLayout
  lang={lang}
  path={path}
  title={t.newsPage.listMetaTitle}
  description={t.newsPage.listMetaDescription}
  alternatePaths={{ en: newsIndexPath("en"), pl: newsIndexPath("pl") }}
>
  <main class="container py-16">
    <header class="mb-12">
      <p class="text-sm uppercase tracking-widest text-zinc-500">{t.newsPage.kicker}</p>
      <h1 class="mt-2 text-3xl font-semibold tracking-tight text-white sm:text-4xl">{t.newsPage.title}</h1>
      <p class="mt-3 max-w-2xl text-zinc-400">{t.newsPage.subtitle}</p>
      <p class="mt-6 text-sm text-zinc-500">
        <a href={homePath(lang)} class="text-zinc-400 hover:text-white">← fotonoza</a>
        <span class="mx-2 text-zinc-600">·</span>
        <a href={homePath(otherLocale(lang))} hreflang={otherLocale(lang)} class="text-zinc-400 hover:text-white">
          {lang === "en" ? "Polski" : "English"}
        </a>
      </p>
    </header>
    <ul class="space-y-8">
      {
        posts.length === 0 ? (
          <li class="text-zinc-500">{t.newsPage.empty}</li>
        ) : (
          posts.map((post) => (
            <li>
              <a
                href={newsArticlePath(lang, post.id)}
                class="group block rounded-xl border border-zinc-800 bg-zinc-900/40 p-6 transition hover:border-zinc-600"
              >
                <time class="text-sm text-zinc-500" datetime={post.data.pubDate.toISOString()}>
                  {post.data.pubDate.toLocaleDateString(lang === "pl" ? "pl-PL" : "en-GB", { timeZone: "UTC" })} UTC
                </time>
                <h2 class="mt-2 text-xl font-medium text-white group-hover:text-zinc-100">{post.data.title}</h2>
                <p class="mt-2 text-zinc-400">{post.data.description}</p>
                {post.data.image ? (
                  <div class="mt-4 overflow-hidden rounded-lg border border-zinc-800">
                    <img src={post.data.image} alt="" class="h-auto w-full object-cover" width={1280} height={720} loading="lazy" />
                  </div>
                ) : null}
              </a>
            </li>
          ))
        )
      }
    </ul>
  </main>
</BaseLayout>
