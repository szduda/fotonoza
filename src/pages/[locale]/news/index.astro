---
import SiteHeader from "@/components/SiteHeader.astro";
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getMessages } from "@/lib/i18n";
import type { Lang } from "@/lib/i18n";
import {
  homePath,
  isSupportedLocale,
  newsArticlePath,
  newsIndexPath,
  newsStorySlugFromEntryId,
  otherLocale,
  switchLocalePath
} from "@/lib/locale";

export function getStaticPaths() {
  return [{ params: { locale: "en" } }, { params: { locale: "pl" } }];
}

const raw = Astro.params.locale;
if (!isSupportedLocale(raw)) {
  return Astro.redirect("/en/");
}

const lang: Lang = raw;
const t = getMessages(lang);
const other = otherLocale(lang);
const homeHref = homePath(lang);
const newsHref = newsIndexPath(lang);
const posts = (await getCollection("progress"))
  .filter((p) => p.data.locale === lang)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const path = newsIndexPath(lang);
---

<BaseLayout
  lang={lang}
  path={path}
  title={t.newsPage.listMetaTitle}
  description={t.newsPage.listMetaDescription}
  alternatePaths={{ en: newsIndexPath("en"), pl: newsIndexPath("pl") }}
>
  <SiteHeader
    lang={lang}
    homeHref={homeHref}
    newsHref={newsHref}
    switchHref={switchLocalePath(Astro.url.pathname, other)}
    switchLabel={lang === "en" ? "🇵🇱 PL" : "🇬🇧 EN"}
    t={t}
  />
  <main class="container py-16">
    <header class="mb-12">
      <p class="text-sm uppercase tracking-widest text-zinc-500">{t.newsPage.kicker}</p>
      <h1 class="mt-2 text-3xl font-semibold tracking-tight text-white sm:text-4xl">{t.newsPage.title}</h1>
      <p class="mt-3 max-w-2xl text-zinc-400">{t.newsPage.subtitle}</p>

    </header>
    <ul class="space-y-8">
      {
        posts.length === 0 ? (
          <li class="text-zinc-500">{t.newsPage.empty}</li>
        ) : (
          posts.map((post, i) => {
            const slug = newsStorySlugFromEntryId(post.id);
            const hasImage = Boolean(post.data.image);
            return (
              <li>
                <a
                  href={newsArticlePath(lang, slug)}
                  class:list={[
                    "group flex flex-col gap-4 rounded-xl border border-zinc-800 bg-zinc-900/40 p-6 transition hover:border-yellow-300/60 hover:shadow-md hover:shadow-yellow-300/5 sm:items-stretch sm:gap-6",
                    hasImage && (i % 2 === 1 ? "sm:flex-row-reverse" : "sm:flex-row")
                  ]}
                >
                  <div class="flex min-w-0 flex-1 flex-col justify-center">
                    <time class="text-sm text-zinc-500" datetime={post.data.pubDate.toISOString()}>
                      {post.data.pubDate.toLocaleDateString(lang === "pl" ? "pl-PL" : "en-GB", { timeZone: "UTC" })} UTC
                    </time>
                    <h2 class="mt-2 text-xl font-medium text-white transition-colors group-hover:text-yellow-300">{post.data.title}</h2>
                    <p class="mt-2 text-zinc-400">{post.data.description}</p>
                  </div>
                  {post.data.image ? (
                    <div class="aspect-video w-full shrink-0 overflow-hidden rounded-lg border border-zinc-800 sm:aspect-video sm:w-72 sm:max-w-[42%] lg:w-96">
                      <img
                        src={post.data.image}
                        alt=""
                        class="h-full w-full object-cover"
                        width={1280}
                        height={720}
                        loading="lazy"
                      />
                    </div>
                  ) : null}
                </a>
              </li>
            );
          })
        )
      }
    </ul>
  </main>
</BaseLayout>
