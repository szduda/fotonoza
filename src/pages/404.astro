---
import BaseLayout from "@/layouts/BaseLayout.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import { getMessages } from "@/lib/i18n";
import { homePath, newsIndexPath } from "@/lib/locale";

const tEn = getMessages("en");
const tPl = getMessages("pl");
const nEn = tEn.notFoundPage;
const nPl = tPl.notFoundPage;
---

<BaseLayout
  lang="en"
  path="/404/"
  title={nEn.metaTitle}
  description={nEn.metaDescription}
  alternatePaths={{ en: homePath("en"), pl: homePath("pl") }}
  enableTracking={false}
>
  <div class="nf404-stack nf404-stack--en" data-nf404="en">
    <SiteHeader
      lang="en"
      homeHref={homePath("en")}
      newsHref={newsIndexPath("en")}
      switchHref={homePath("pl")}
      switchLabel="🇵🇱 PL"
      t={tEn}
    />

    <article class="container py-16">
      <header class="mx-auto max-w-3xl">
        <time class="mt-4 block text-sm text-mist-500">{nEn.timeLabel}</time>
        <h1
          class="mt-2 text-3xl font-semibold tracking-tight text-white sm:text-4xl"
        >
          {nEn.title}
        </h1>
        <p class="mt-3 text-lg text-mist-400">{nEn.subtitle}</p>
        <figure
          class="mt-10 overflow-hidden rounded-xl border border-mist-800 bg-mist-900/60 p-3"
        >
          <img
            src="/404-photorealistic.png"
            alt={nEn.imgAltPhoto}
            width={1280}
            height={720}
            class="h-auto max-h-[60dvh] w-full rounded-lg object-contain"
          />
          <figcaption class="mt-3 text-xs text-mist-500">
            {nEn.captionPhoto}
          </figcaption>
        </figure>
      </header>

      <div
        class="mx-auto mt-12 max-w-3xl space-y-6 leading-relaxed text-mist-400"
      >
        <p>{nEn.body1}</p>
        <p>{nEn.body2}</p>
        <p>{nEn.body3}</p>

        <div class="pt-2">
          <figure
            class="overflow-hidden rounded-xl border border-mist-800 bg-mist-900/60 p-3"
          >
            <img
              src="/404-comic.png"
              alt={nEn.imgAltComic}
              width={1280}
              height={720}
              class="h-auto max-h-[60dvh] w-full rounded-lg object-contain"
            />
            <figcaption class="mt-3 text-xs text-mist-500">
              {nEn.captionComic}
            </figcaption>
          </figure>
        </div>
      </div>
    </article>
  </div>

  <div class="nf404-stack nf404-stack--pl hidden" data-nf404="pl">
    <SiteHeader
      lang="pl"
      homeHref={homePath("pl")}
      newsHref={newsIndexPath("pl")}
      switchHref={homePath("en")}
      switchLabel="🇬🇧 EN"
      t={tPl}
    />

    <article class="container py-16">
      <header class="mx-auto max-w-3xl">
        <p class="text-sm text-mist-500">
          <a
            href={newsIndexPath("pl")}
            class="text-mist-400 transition-colors hover:text-yellow-300 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-yellow-300/80 focus-visible:ring-offset-2 focus-visible:ring-offset-mist-950"
          >
            {tPl.newsPage.backToNews}
          </a>
          <span class="mx-2 text-mist-600">·</span>
          <a
            href={homePath("pl")}
            class="text-mist-400 transition-colors hover:text-yellow-300 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-yellow-300/80 focus-visible:ring-offset-2 focus-visible:ring-offset-mist-950"
          >
            fotonoza
          </a>
        </p>
        <time class="mt-4 block text-sm text-mist-500">{nPl.timeLabel}</time>
        <h1
          class="mt-2 text-3xl font-semibold tracking-tight text-white sm:text-4xl"
        >
          {nPl.title}
        </h1>
        <p class="mt-3 text-lg text-mist-400">{nPl.subtitle}</p>
        <figure
          class="mt-10 overflow-hidden rounded-xl border border-mist-800 bg-mist-900/60 p-3"
        >
          <img
            src="/404-photorealistic.png"
            alt={nPl.imgAltPhoto}
            width={1280}
            height={720}
            class="h-auto max-h-[60dvh] w-full rounded-lg object-contain"
          />
          <figcaption class="mt-3 text-xs text-mist-500">
            {nPl.captionPhoto}
          </figcaption>
        </figure>
      </header>

      <div
        class="mx-auto mt-12 max-w-3xl space-y-6 leading-relaxed text-mist-400"
      >
        <p>{nPl.body1}</p>
        <p>{nPl.body2}</p>
        <p>{nPl.body3}</p>

        <div class="pt-2">
          <figure
            class="overflow-hidden rounded-xl border border-mist-800 bg-mist-900/60 p-3"
          >
            <img
              src="/404-comic.png"
              alt={nPl.imgAltComic}
              width={1280}
              height={720}
              class="h-auto max-h-[60dvh] w-full rounded-lg object-contain"
            />
            <figcaption class="mt-3 text-xs text-mist-500">
              {nPl.captionComic}
            </figcaption>
          </figure>
        </div>
      </div>
    </article>
  </div>

  <script
    is:inline
    define:vars={{
      plMetaTitle: nPl.metaTitle,
      plMetaDescription: nPl.metaDescription,
    }}
  >
    (function () {
      var path = window.location.pathname || "";
      var isPl = /^\/pl(\/|$)/.test(path);
      document.documentElement.lang = isPl ? "pl" : "en";
      var en = document.querySelector('[data-nf404="en"]');
      var pl = document.querySelector('[data-nf404="pl"]');
      if (en && pl) {
        en.classList.toggle("hidden", isPl);
        pl.classList.toggle("hidden", !isPl);
      }
      if (isPl) {
        var titleEl = document.querySelector("title");
        if (titleEl) titleEl.textContent = plMetaTitle;
        var meta = document.querySelector('meta[name="description"]');
        if (meta) meta.setAttribute("content", plMetaDescription);
      }
    })();
  </script>
</BaseLayout>
