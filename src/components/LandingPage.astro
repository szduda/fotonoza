---
import type { Lang, Messages } from "@/lib/i18n";

interface Props {
  lang: Lang;
  switchHref: string;
  switchLabel: string;
  t: Messages;
}

const { lang, switchHref, switchLabel, t } = Astro.props;

const featureColorPool = [
  "bg-fuchsia-500/80",
  "bg-fuchsia-600/80",
  "bg-fuchsia-700/80",
  "bg-fuchsia-500/70",
  "bg-fuchsia-700/70",
  "bg-sky-500/80",
  "bg-sky-600/80",
  "bg-sky-700/80",
  "bg-sky-500/70",
  "bg-sky-700/70",
  "bg-emerald-500/80",
  "bg-emerald-600/80",
  "bg-emerald-700/80",
  "bg-emerald-500/70",
  "bg-emerald-700/70",
  "bg-amber-400/80",
  "bg-amber-500/80",
  "bg-amber-600/80",
  "bg-amber-400/70",
  "bg-amber-600/70",
  "bg-rose-500/80",
  "bg-rose-600/80",
  "bg-rose-700/80",
  "bg-rose-500/70",
  "bg-rose-700/70"
];

const shuffledColorIndexes = [
  12, 1, 23, 8, 16,
  4, 19, 6, 21, 14,
  9, 24, 11, 3, 18,
  0, 17, 10, 22, 5,
  15, 2, 13, 20, 7
];
---

<header class="sticky top-0 z-50 border-b border-zinc-800/70 bg-zinc-950/90 backdrop-blur">
  <nav class="container flex h-16 items-center justify-between">
    <div class="flex items-center gap-8">
      <a href="#top" class="text-lg font-semibold tracking-wide text-zinc-100">fotonoza</a>
      <div class="flex items-center gap-5 text-sm text-zinc-300">
      <a class="hover:text-white" href="#features">{t.nav.features}</a>
      <a class="hover:text-white" href="#all-features">{t.nav.allFeatures}</a>
      <a class="hover:text-white" href="#download">{t.nav.download}</a>
      </div>
    </div>
    <a
      href={switchHref}
      hreflang={lang === "en" ? "pl" : "en"}
      class="rounded border border-zinc-700 px-2 py-1 text-xs font-medium text-zinc-100 hover:border-zinc-400"
    >
      {switchLabel}
    </a>
  </nav>
</header>

<main id="top">
  <section class="container grid min-h-[90vh] items-center gap-8 py-20 md:grid-cols-2">
    <div>
      <p class="mb-4 inline-flex rounded-full border border-zinc-700 px-3 py-1 text-xs uppercase tracking-wider text-zinc-300">
        Free. Open source. Static-first.
      </p>
      <h1 class="text-4xl font-bold leading-tight sm:text-5xl">{t.hero.headline}</h1>
      <p class="mt-5 max-w-xl text-lg text-zinc-300">{t.hero.tagline}</p>
      <a
        href="#download"
        class="mt-8 inline-flex rounded bg-white px-5 py-3 text-sm font-semibold text-zinc-900 transition hover:bg-zinc-200"
      >
        {t.hero.cta}
      </a>
    </div>
    <img
      class="aspect-video rounded bg-gray-600 object-cover"
      src="/images/hero-shot.jpg"
      alt={t.hero.imageAlt}
      loading="eager"
    />
  </section>

  <section id="features" class="border-y border-zinc-800 bg-zinc-900/40 py-20">
    <div class="container grid gap-8 md:grid-cols-2">
      <div>
        <h2 class="text-3xl font-semibold">{t.someFeatures.title}</h2>
        <p class="mt-3 text-zinc-300">{t.someFeatures.subtitle}</p>
        <ul class="mt-6 grid gap-3 text-zinc-200">
          {t.someFeatures.items.map((item) => <li class="rounded border border-zinc-800 p-3">{item}</li>)}
        </ul>
      </div>
      <div class="space-y-6">
        <img
          class="aspect-video rounded bg-gray-600 object-cover"
          src="/images/features-shot.jpg"
          alt={t.images.featuresAlt}
          loading="lazy"
        />
        <div>
          <h3 class="text-xl font-semibold">{t.extra.title}</h3>
          <ul class="mt-3 space-y-2 text-zinc-300">
            {t.extra.items.map((item) => <li>• {item}</li>)}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section id="all-features" class="container py-20">
    <h2 class="text-3xl font-semibold">{t.allFeatures.title}</h2>
    <p class="mt-3 text-zinc-300">{t.allFeatures.subtitle}</p>
    <div class="mt-8 grid grid-cols-2 gap-3 sm:grid-cols-3 md:grid-cols-5">
      {
        t.allFeatures.items.map((feature, idx) => (
          <div
            class={`group relative aspect-square overflow-hidden rounded p-3 shadow ${featureColorPool[shuffledColorIndexes[idx]]}`}
          >
            <span class="absolute inset-0 flex items-center justify-center p-3 text-center text-base font-extrabold uppercase tracking-wide text-white transition-opacity duration-200 group-hover:opacity-0">
              {feature}
            </span>
            <span class="absolute inset-0 flex items-center justify-center p-3 text-center text-xs font-medium text-white opacity-0 transition-opacity duration-200 group-hover:opacity-100">
              {t.allFeatures.descriptions[idx]}
            </span>
          </div>
        ))
      }
    </div>
  </section>

  <section id="download" class="border-t border-zinc-800 bg-zinc-900/40 py-20">
    <div class="container">
      <h2 class="text-3xl font-semibold">{t.download.title}</h2>
      <p class="mt-3 text-zinc-300">{t.download.subtitle}</p>
      <div class="mt-8 grid gap-4 md:grid-cols-3">
        <div class="rounded border border-zinc-800 p-5">
          <h3 class="text-lg font-semibold">{t.download.linux.label}</h3>
          <div class="mt-4 grid grid-cols-2 gap-2">
            {
              t.download.linux.packages.map((item) => <div class="rounded border border-zinc-700 p-3 text-center">{item}</div>)
            }
          </div>
        </div>
        <div class="rounded border border-zinc-800 p-5">
          <h3 class="text-lg font-semibold">{t.download.windows.label}</h3>
          <div class="mt-4 grid gap-2">
            {
              t.download.windows.packages.map((item) => (
                <div class="rounded border border-zinc-700 p-3 text-center">{item}</div>
              ))
            }
          </div>
        </div>
        <div class="rounded border border-zinc-800 p-5">
          <h3 class="text-lg font-semibold">{t.download.macos.label}</h3>
          <div class="mt-4 grid gap-2">
            {t.download.macos.packages.map((item) => <div class="rounded border border-zinc-700 p-3 text-center">{item}</div>)}
          </div>
        </div>
      </div>
      <p class="mt-6 text-sm text-zinc-400">{t.download.note}</p>
    </div>
  </section>
</main>

<footer class="container border-t border-zinc-800 py-8 text-sm text-zinc-400">
  <p>{t.footer.copyright}</p>
</footer>
