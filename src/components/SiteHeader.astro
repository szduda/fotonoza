---
import type { Lang, Messages } from "@/lib/i18n";

interface Props {
  lang: Lang;
  homeHref: string;
  newsHref: string;
  switchHref: string;
  switchLabel: string;
  instantHomeAnchors?: boolean;
  t: Messages;
}

const {
  lang,
  homeHref,
  newsHref,
  switchHref,
  switchLabel,
  instantHomeAnchors = false,
  t,
} = Astro.props;
const homeAnchorBase = instantHomeAnchors ? `${homeHref}?jump=1` : homeHref;

const linkStyle =
  "font-medium transition-colors hover:text-yellow-300 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-yellow-300/80 focus-visible:ring-offset-2 focus-visible:ring-offset-mist-950";
---

<header
  class="sticky top-0 inset-x-0 z-50 border-b border-mist-700/50 bg-mist-950/80 backdrop-blur"
>
  <nav class="container flex h-16 items-center justify-between">
    <div class="flex items-center gap-8">
      <a
        href={`${homeHref}#top`}
        class={`flex items-center gap-2 text-lg font-semibold tracking-wide text-mist-300 ${linkStyle}`}
        data-track="nav_logo"
      >
        <img
          src="/fotonoza-logo.svg"
          alt=""
          width={32}
          height={32}
          class="h-8 w-8 shrink-0"
          decoding="async"
        />
        <span class="hidden sm:inline">fotonoza</span>
      </a>

      <div class="flex items-center gap-5 text-sm text-mist-400">
        <a class={linkStyle} href={`${homeAnchorBase}#features`} data-track="nav_features">
          {t.nav.features}
        </a>

        <a class={linkStyle} href={`${homeAnchorBase}#download`} data-track="nav_download">
          {t.nav.download}
        </a>

        <a class={linkStyle} href={newsHref} data-track="nav_news">
          {t.nav.news}
        </a>
      </div>
    </div>

    <a
      href={switchHref}
      hreflang={lang === "en" ? "pl" : "en"}
      class={`rounded border border-mist-700 px-2 py-1 text-xs font-medium text-mist-400 hover:border-yellow-300/30 hover:bg-yellow-200/5 ${linkStyle}`}
      data-track="lang_switch"
    >
      {switchLabel}
    </a>
  </nav>
</header>
