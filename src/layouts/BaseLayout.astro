---
import "@/styles/global.css";

interface Props {
  title: string;
  description: string;
  lang: "en" | "pl";
  path: string;
  /** Same page in the other locale (path only, e.g. `/en/news/foo/`) */
  alternatePaths: { en: string; pl: string };
  /** When false, no outbound tracking (e.g. 404 page). Default true. */
  enableTracking?: boolean;
}

const { title, description, lang, path, alternatePaths, enableTracking = true } = Astro.props;

const trackingBase = (import.meta.env.PUBLIC_TRACKING_BASE ?? "").replace(/\/$/, "");
const trackingCode = import.meta.env.PUBLIC_TRACKING_INGEST_CODE ?? "";
const trackingPk = import.meta.env.PUBLIC_TRACKING_PUBLIC_KEY ?? "";
const trackingEnabledEnv = import.meta.env.PUBLIC_TRACKING_ENABLED !== "false";
const trackingOn =
  enableTracking &&
  trackingEnabledEnv &&
  Boolean(trackingBase && trackingCode && trackingPk);
const baseUrl = "https://fotonoza.vercel.app";
const canonical = new URL(path, baseUrl).toString();
const ogImage = new URL("/images/og-fotonoza.jpg", baseUrl).toString();
---

<!doctype html>
<html
  lang={lang}
  data-tracking-base={trackingOn ? trackingBase : undefined}
  data-tracking-code={trackingOn ? trackingCode : undefined}
  data-tracking-pk={trackingOn ? trackingPk : undefined}
>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="noindex, nofollow, noarchive, nosnippet, noimageindex" />
    <meta name="googlebot" content="noindex, nofollow, noarchive, nosnippet, noimageindex" />
    <meta name="bingbot" content="noindex, nofollow, noarchive, nosnippet, noimageindex" />
    <meta name="author" content="fotonoza open source community" />
    <meta name="theme-color" content="#09090b" />
    <meta name="format-detection" content="telephone=no" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en" href={new URL(alternatePaths.en, baseUrl).href} />
    <link rel="alternate" hreflang="pl" href={new URL(alternatePaths.pl, baseUrl).href} />
    <link rel="alternate" hreflang="x-default" href={new URL(alternatePaths.en, baseUrl).href} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="fotonoza" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content="fotonoza - minimal photo editor landing page" />
    <meta property="og:locale" content={lang === "pl" ? "pl_PL" : "en_US"} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:site" content="@fotonoza" />

    <meta name="application-name" content="fotonoza" />
    <meta name="apple-mobile-web-app-title" content="fotonoza" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <link rel="icon" type="image/png" href="/favicon-16x16.png?v=2" sizes="16x16" />
    <link rel="icon" type="image/png" href="/favicon-32x32.png?v=2" sizes="32x32" />
    <link rel="icon" type="image/png" href="/icon-192.png?v=2" sizes="192x192" />
    <link rel="icon" type="image/png" href="/icon-512.png?v=2" sizes="512x512" />
    <link rel="icon" href="/favicon.ico?v=2" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png?v=2" sizes="180x180" />
    <script is:inline>
      (() => {
        const url = new URL(window.location.href);
        if (url.searchParams.get("jump") !== "1") return;
        document.documentElement.style.scrollBehavior = "auto";
        window.addEventListener(
          "load",
          () => {
            document.documentElement.style.scrollBehavior = "";
            url.searchParams.delete("jump");
            const next = `${url.pathname}${url.search}${url.hash}`;
            window.history.replaceState({}, "", next);
          },
          { once: true }
        );
      })();
    </script>
    {trackingOn ? <script is:inline src="/webcare-client.js"></script> : null}
  </head>
  <body>
    <slot />
  </body>
</html>
