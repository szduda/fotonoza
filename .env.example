# Copy to .env (gitignored). Vercel: Project → Settings → Environment Variables.

# --- Cursor (not GitHub) — https://cursor.com/dashboard → API / Cloud Agents
# Used by `npm run backfill` locally and by GitHub Actions `progress-generate.yml`.
CURSOR_API_KEY=

# --- GitHub Actions (this repo → Settings → Secrets and variables → Actions)
# FOTONOZA_APP_GIT_URL — HTTPS clone URL for **private** fotonoza-app, PAT embedded (Contents read on that repo only):
#   https://x-access-token:<PAT>@github.com/<org>/fotonoza-app.git
# Same pattern as below; store only as a secret, never commit.
#
# progress-generate: if `gh pr create` fails with “not permitted to create or approve pull requests”, either
#   enable Settings → Actions → General → Workflow permissions → Read and write + “Allow GitHub Actions to create
#   and approve pull requests”, OR add optional repository secret GH_PR_CREATE_TOKEN (PAT on this repo: Pull
#   requests write; gh uses it only for PR creation, not for git push).
#
# --- fotonoza (this repo) — HTTPS remote with PAT for `npm run backfill -- --push` and **required** for progress-generate in Actions
# Fine-grained PAT on repo fotonoza only: Contents read-write, Pull requests read-write.
# https://x-access-token:<PAT>@github.com/<org>/fotonoza.git — **required** as a GitHub Actions secret for progress-generate
# so `git push` uses the PAT (GITHUB_TOKEN-only pushes often do not trigger `pull_request` workflows on the new PR). Locally, omit if
# `git push` / `gh` already work from your login.
# FOTONOZA_GIT_URL=

# --- Local path to fotonoza-app (optional; default sibling ../fotonoza-app)
# FOTONOZA_APP_ROOT=

# --- Client (PUBLIC_* may ship to the browser)
# PUBLIC_TRACKING_BASE=…
# PUBLIC_TRACKING_INGEST_CODE=…
# PUBLIC_TRACKING_PUBLIC_KEY=…
# PUBLIC_TRACKING_ENABLED=false
