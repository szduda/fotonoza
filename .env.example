# Copy to .env (gitignored). Vercel: Project → Settings → Environment Variables.

# --- Cursor (not GitHub) — https://cursor.com/dashboard → API / Cloud Agents
# Used by `npm run backfill` locally and by GitHub Actions `progress-generate.yml`.
CURSOR_API_KEY=

# --- GitHub Actions (this repo → Settings → Secrets and variables → Actions)
# FOTONOZA_APP_GIT_URL — HTTPS clone URL for **private** fotonoza-app, PAT embedded (Contents read on that repo only):
#   https://x-access-token:<PAT>@github.com/<org>/fotonoza-app.git
# Same pattern as below; store only as a secret, never commit.

# --- fotonoza (this repo) — optional HTTPS remote with PAT for `npm run backfill -- --push`
# Fine-grained PAT on repo fotonoza only: Contents read-write, Pull requests read-write.
# https://x-access-token:<PAT>@github.com/<org>/fotonoza.git
# Omit if `git push` / `gh` already work from your login. Not used for push when `GITHUB_ACTIONS=true` (CI always uses `origin` + `GITHUB_TOKEN`).
# FOTONOZA_GIT_URL=

# --- Local path to fotonoza-app (optional; default sibling ../fotonoza-app)
# FOTONOZA_APP_ROOT=

# --- Client (PUBLIC_* may ship to the browser)
# PUBLIC_TRACKING_BASE=…
# PUBLIC_TRACKING_INGEST_CODE=…
# PUBLIC_TRACKING_PUBLIC_KEY=…
# PUBLIC_TRACKING_ENABLED=false
