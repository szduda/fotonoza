# Copy to .env (gitignored). Vercel: Project → Settings → Environment Variables.

# --- Cursor (not GitHub) — https://cursor.com/dashboard → API / Cloud Agents
CURSOR_API_KEY=

# --- fotonoza-app — same shape on Vercel and locally when you use HTTPS + token
# Fine-grained PAT on repo fotonoza-app only: Contents → Read-only.
# https://x-access-token:<PAT>@github.com/<org>/fotonoza-app.git
# Vercel cron: required so the function can git clone the app into /tmp.
# Git is run via the `dugite` npm package (bundled Git), not `/usr/bin/git` (missing on Vercel Node).
# Local: optional; usually you use FOTONOZA_APP_ROOT or ../fotonoza-app instead.
# FOTONOZA_APP_GIT_URL=

# --- fotonoza (this repo) — same shape; used only when you --push / cron push + PR
# Fine-grained PAT on repo fotonoza only: Contents read-write, Pull requests read-write.
# https://x-access-token:<PAT>@github.com/<org>/fotonoza.git
# Omit locally if `git push` / `gh` already work from your login.
# FOTONOZA_GIT_URL=

# --- Local path to fotonoza-app (optional; default sibling ../fotonoza-app)
# FOTONOZA_APP_ROOT=

# FOTONOZA_PREVIEW_URL=http://127.0.0.1:4173
# FOTONOZA_APP_VITE_BUILD_ONLY=1

# --- Vercel cron only — random string; Vercel sends Authorization: Bearer …
CRON_SECRET=
# CRON_NO_PR=1

# --- Client (PUBLIC_* may ship to the browser)
# PUBLIC_TRACKING_BASE=…
# PUBLIC_TRACKING_INGEST_CODE=…
# PUBLIC_TRACKING_PUBLIC_KEY=…
# PUBLIC_TRACKING_ENABLED=false

# sanitizeEnv.mjs strips these from vite/Playwright child env (do not rely on them there):
# CURSOR_API_KEY, OPENAI_API_KEY, ANTHROPIC_API_KEY, AWS_* , FOTONOZA_APP_GIT_URL, FOTONOZA_GIT_URL
