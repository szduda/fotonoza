# Cursor Cloud Agents / API — https://cursor.com/dashboard/cloud-agents
CURSOR_API_KEY=

# Path to fotonoza-app clone (default: sibling directory ../fotonoza-app)
# FOTONOZA_APP_ROOT=

# Preview URL after `vite preview` (default http://127.0.0.1:4173)
# FOTONOZA_PREVIEW_URL=

# Skip `tsc` in fotonoza-app and run `npx vite build` only (optional; otherwise the
# pipeline tries `npm run build` first and falls back to vite if tsc fails).
# FOTONOZA_APP_VITE_BUILD_ONLY=1
